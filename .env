# IFSP Web App — Environment Configuration
# This file is loaded automatically by run.py on startup.
# Copy this file and adjust values for your environment.

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_JUDGE_MODEL=llama3.1:8b
OLLAMA_JUDGE_ENABLED=true

# Dedicated coding model for Text-to-SQL generation.
# deepseek-coder produces better SQL than a general chat model.
OLLAMA_SQL_MODEL=deepseek-coder:latest

# Vision model for /api/vision-query and vision_query chat intent.
# Requires a vision-capable model — pull with: ollama pull llama3.2-vision:latest
# Falls back to llama3.2:latest (text-only, no image support) until changed.
OLLAMA_VISION_MODEL=llama3.2:latest

# Router LLM fallback threshold (0.0-1.0).
# When keyword confidence < this value, Ollama is called to classify the intent.
OLLAMA_ROUTER_CONFIDENCE_THRESHOLD=0.3

# ── SQL Backend ───────────────────────────────────────────────────────────────
# duckdb    — default, reads CSV files in-memory, zero setup
# snowflake — set when Snowflake connectivity is available
SQL_BACKEND=duckdb

# ── Snowflake (future) ────────────────────────────────────────────────────────
# Uncomment and fill in when SQL_BACKEND=snowflake
# SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_DATABASE=IFSP_DB
# SNOWFLAKE_SCHEMA=BY_ESP
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=PLANNER_ROLE
