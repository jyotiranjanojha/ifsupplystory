# ======================================================================
# LLM PROVIDER CONFIGURATION
# ======================================================================
# Choose which LLM provider to use: 'nollama', 'openai', 'custom', or 'openvino'
LLM_PROVIDER=nollama

# ======================================================================
# NOLLAMA CONFIGURATION (Local OpenAI-compatible v1 API)
# Use this when running NoLlama locally for development/testing
# ======================================================================
NOLLAMA_BASE_URL=http://localhost:8000
NOLLAMA_MODEL=Qwen2.5-Coder-7B-Instruct@GPU
NOLLAMA_JUDGE_MODEL=Qwen2.5-Coder-7B-Instruct@GPU
NOLLAMA_VISION_MODEL=Qwen2.5-Coder-7B-Instruct@GPU

# ======================================================================
# OPENAI CONFIGURATION (Production)
# Use this to connect to OpenAI's API
# ======================================================================
# OPENAI_API_KEY=sk-YOUR_API_KEY_HERE
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_JUDGE_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o

# ======================================================================
# ANTHROPIC CONFIGURATION (Claude models)
# Uses x-api-key header (not Bearer token)
# ======================================================================
# ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_JUDGE_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# ======================================================================
# AZURE OPENAI CONFIGURATION
# Different URL format: no /v1/ prefix, uses deployment name, api-key header
# ======================================================================
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://myresource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-deployment
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4o-deployment
# AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o-deployment

# ======================================================================
# CUSTOM LLM PROVIDER (Any OpenAI-compatible API)
# Use this for other OpenAI-compatible LLM services
# Examples: Azure OpenAI, Anthropic Claude via proxy, LM Studio, etc.
# ======================================================================
# CUSTOM_LLM_BASE_URL=https://your-provider.com/v1
# CUSTOM_LLM_API_KEY=your-api-key-here
# CUSTOM_LLM_MODEL=model-name

# ======================================================================
# OPENVINO CONFIGURATION (Optimized local inference with latency hints)
# Use this for high-performance local inference with GPU acceleration
# Requirements: openvino_genai package + quantized model files
# ======================================================================
# OPENVINO_MODEL_PATH=C:\Users\jojha\OneDrive - Intel Corporation\Documents\NoLlama\model
# OPENVINO_DEVICE=GPU  # GPU, CPU, NPU
# OPENVINO_PERFORMANCE_HINT=LATENCY  # LATENCY or THROUGHPUT
# OPENVINO_NUM_STREAMS=1  # For THROUGHPUT mode
# OPENVINO_MODEL=deepseek-r1-distill-qwen-7b
# OPENVINO_JUDGE_MODEL=deepseek-r1-distill-qwen-7b
# OPENVINO_VISION_MODEL=deepseek-r1-distill-qwen-7b# OPENVINO_EMBEDDING_MODEL_PATH=./embedding_model/bge-small-en-v1.5
# OPENVINO_RERANKER_MODEL_PATH=./embedding_model/bge-reranker-base
# OPENVINO_RERANKER_ENABLED=false  # Set to true after exporting reranker model
# OPENVINO_RERANKER_TOP_N=3

# ======================================================================
# RAG DATA SOURCE
# ======================================================================
# RAG_SOURCE=csv          # Default: read from by_input/ and by_output/
# RAG_SOURCE=snowflake    # Read from Snowflake tables
# RAG_MAX_ROWS_PER_FILE=500

# ======================================================================
# SNOWFLAKE CONFIGURATION (used when RAG_SOURCE=snowflake)
# ======================================================================
# SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
# SNOWFLAKE_USER=your-user
# SNOWFLAKE_PASSWORD=your-password
# SNOWFLAKE_DATABASE=IFSP_DB
# SNOWFLAKE_SCHEMA=PLANNING
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=SYSADMIN
# ======================================================================
# JUDGE/REVIEW LLM SETTINGS
# ======================================================================
JUDGE_LLM_ENABLED=true

# ======================================================================
# OLLAMA CONFIGURATION (Deprecated, use LLM_PROVIDER instead)
# These are kept for backward compatibility
# ======================================================================
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:latest
# OLLAMA_JUDGE_MODEL=llama3.1:8b
# OLLAMA_JUDGE_ENABLED=true
# OLLAMA_VISION_MODEL=gemma3:latest

# ======================================================================
# OTHER CONFIGURATION
# ======================================================================
OLLAMA_BASE_URL=http://localhost:8000
