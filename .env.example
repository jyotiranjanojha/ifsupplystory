# ======================================================================
# LLM PROVIDER CONFIGURATION
# ======================================================================
# Choose which LLM provider to use: 'nollama', 'openai', or 'custom'
LLM_PROVIDER=nollama

# ======================================================================
# NOLLAMA CONFIGURATION (Local OpenAI-compatible v1 API)
# Use this when running NoLlama locally for development/testing
# ======================================================================
NOLLAMA_BASE_URL=http://localhost:8000
NOLLAMA_MODEL=qwen2@GPU
NOLLAMA_JUDGE_MODEL=qwen2@GPU
NOLLAMA_VISION_MODEL=qwen2@GPU

# ======================================================================
# OPENAI CONFIGURATION (Production)
# Use this to connect to OpenAI's API
# ======================================================================
# OPENAI_API_KEY=sk-YOUR_API_KEY_HERE
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4
# OPENAI_JUDGE_MODEL=gpt-4
# OPENAI_VISION_MODEL=gpt-4-vision-preview

# ======================================================================
# CUSTOM LLM PROVIDER (Any OpenAI-compatible API)
# Use this for other OpenAI-compatible LLM services
# Examples: Azure OpenAI, Anthropic Claude via proxy, LM Studio, etc.
# ======================================================================
# CUSTOM_LLM_BASE_URL=https://your-provider.com/v1
# CUSTOM_LLM_API_KEY=your-api-key-here
# CUSTOM_LLM_MODEL=model-name

# ======================================================================
# JUDGE/REVIEW LLM SETTINGS
# ======================================================================
JUDGE_LLM_ENABLED=true

# ======================================================================
# OLLAMA CONFIGURATION (Deprecated, use LLM_PROVIDER instead)
# These are kept for backward compatibility
# ======================================================================
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:latest
# OLLAMA_JUDGE_MODEL=llama3.1:8b
# OLLAMA_JUDGE_ENABLED=true
# OLLAMA_VISION_MODEL=gemma3:latest

# ======================================================================
# OTHER CONFIGURATION
# ======================================================================
OLLAMA_BASE_URL=http://localhost:8000
